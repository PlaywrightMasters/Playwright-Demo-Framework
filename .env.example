# Optional overrides. Every value has a default in src/config/env.ts.
# Export these in your shell or CI job; the framework does not load .env files itself.

# Web application under test (chromium / firefox / webkit projects)
BASE_URL=https://the-internet.herokuapp.com

# REST API under test (api project)
API_BASE_URL=https://jsonplaceholder.typicode.com

# Response-time budget for API performance checks, in milliseconds
API_RESPONSE_TIME_BUDGET_MS=5000
